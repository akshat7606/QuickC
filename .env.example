# Example .env for local Docker or remote deploy
# Copy this to .env and fill values before running docker-compose or docker run

# Database (sqlite example or postgres)
# For sqlite (local dev) you can use: sqlite:///./cab_aggregator.db
DATABASE_URL=sqlite:///./cab_aggregator.db

# MapMyIndia credentials (set if you use mapmyindia endpoints)
MAPMYINDIA_REST_KEY=
MAPMYINDIA_CLIENT_ID=
MAPMYINDIA_CLIENT_SECRET=

# CORS: comma separated origins allowed by FastAPI
FRONTEND_ORIGINS=http://localhost:8000

# Build-time frontend API URL (Vite - used during build)
VITE_API_URL=http://localhost:8000

