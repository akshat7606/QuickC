# Multi-stage build: build Vite app, serve with nginx

FROM node:20-alpine AS build
WORKDIR /app

# Copy package files and install
COPY frontend/package.json frontend/package-lock.json* ./
COPY frontend/tsconfig*.json ./
COPY frontend/ ./

RUN npm ci --silent
RUN npm run build

# Production image
FROM nginx:stable-alpine
COPY --from=build /app/dist /usr/share/nginx/html

# Replace default nginx config with one that proxies /api to backend and serves SPA
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copy helper scripts to print info at container startup
COPY docker/print-frontend-info.sh /docker/print-frontend-info.sh
COPY docker/frontend-entrypoint.sh /docker/frontend-entrypoint.sh
RUN chmod +x /docker/print-frontend-info.sh /docker/frontend-entrypoint.sh

EXPOSE 80
# Use an entrypoint that prints helpful info then starts nginx
ENTRYPOINT ["/docker/frontend-entrypoint.sh"]
